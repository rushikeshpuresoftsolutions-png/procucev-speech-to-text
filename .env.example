# Optional. Compose generates persistent random credentials when these are blank.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=speech_to_text_db
MYSQL_USER=studio
MYSQL_PASSWORD=
# Optional full SQLAlchemy URL for an external database (mysql+pymysql://...).
DATABASE_URL=
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=2
WHISPER_THREADS=2
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Blank uses the frontend origin and Vite's local reverse proxy.
VITE_API_URL=
VITE_WS_URL=
